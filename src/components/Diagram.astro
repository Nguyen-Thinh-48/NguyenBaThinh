---
/**
 * A framed container for an inline SVG (or any block) that sits beside prose.
 * Inline SVG is used instead of an image file so the diagram picks up the
 * current theme's colours through CSS custom properties.
 */
interface Props {
  caption?: string;
  /** Pad the frame less — for diagrams that already have internal padding. */
  flush?: boolean;
}

const { caption, flush = false } = Astro.props;
---

<figure class:list={['diagram', { flush }]}>
  <div class="frame">
    <slot />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .frame {
    padding: 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow-x: auto;
  }

  .flush .frame {
    padding: 0.5rem;
  }

  .frame :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Shared vocabulary for every diagram on the site. */
  .frame :global(.d-box) {
    fill: var(--surface-2);
    stroke: var(--border-strong);
    stroke-width: 1.2;
  }

  .frame :global(.d-box-accent) {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1.4;
  }

  .frame :global(.d-box-signal) {
    fill: var(--signal-soft);
    stroke: var(--signal);
    stroke-width: 1.4;
  }

  .frame :global(.d-label) {
    fill: var(--text);
    font-family: var(--font-display);
    font-size: 12.5px;
    font-weight: 600;
  }

  .frame :global(.d-sub) {
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
  }

  .frame :global(.d-edge) {
    stroke: var(--border-strong);
    stroke-width: 1.3;
    fill: none;
  }

  .frame :global(.d-edge-accent) {
    stroke: var(--accent);
    stroke-width: 1.5;
    fill: none;
  }

  .frame :global(.d-edge-label) {
    fill: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .frame :global(.d-arrow) {
    fill: var(--border-strong);
  }

  .frame :global(.d-arrow-accent) {
    fill: var(--accent);
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 0.735rem;
    line-height: 1.55;
    color: var(--text-faint);
    padding-left: 0.1rem;
  }
</style>
