---
import { url } from '../lib/url';

interface Props {
  /** Site-root relative path, e.g. "/media/connected-drone/demo.mp4" */
  src: string;
  poster?: string;
  caption?: string;
  /** Short clips can loop silently as a moving screenshot. Long ones should not. */
  autoplay?: boolean;
  /** Aspect ratio box so the layout does not jump while metadata loads. */
  ratio?: string;
  class?: string;
}

const {
  src,
  poster,
  caption,
  autoplay = false,
  ratio = '16 / 9',
  class: className,
} = Astro.props;

// A phone recording is taller than it is wide. Left at full column width it
// would be over a thousand pixels tall, so those get capped and centred.
const [w = 16, h = 9] = ratio.split('/').map((n) => Number(n.trim()));
const portrait = h > w;
---

<figure class:list={['video-figure', { portrait }, className]}>
  <div class="frame" style={`--ratio: ${ratio}`}>
    <video
      src={url(src)}
      poster={poster ? url(poster) : undefined}
      controls
      playsinline
      muted={autoplay}
      loop={autoplay}
      autoplay={autoplay}
      preload="metadata"
      aria-label={caption}></video>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .frame {
    position: relative;
    aspect-ratio: var(--ratio);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #05070b;
    box-shadow: var(--shadow-md);
  }

  /* 340px wide at 9:16 is ~600px tall — tall enough to read, short enough that
     it does not push the rest of the case study off the screen. */
  .portrait .frame {
    max-width: 340px;
    margin-inline: auto;
  }

  .portrait figcaption {
    max-width: 340px;
    margin-inline: auto;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #05070b;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 0.735rem;
    line-height: 1.55;
    color: var(--text-faint);
    padding-left: 0.1rem;
  }
</style>
