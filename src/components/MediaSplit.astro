---
/**
 * Text on one side, media on the other — the core layout of a case study.
 *
 * Usage inside an .mdx project file:
 *
 *   <MediaSplit flip>
 *     <Video slot="media" src="/media/x/demo.mp4" caption="..." />
 *
 *     ### Heading
 *     Prose and bullets go here.
 *   </MediaSplit>
 *
 * The media column is always second in the DOM, so on a phone the text is read
 * first and the media stacks underneath. `flip` only swaps the visual order on
 * wide screens.
 */
interface Props {
  /** Put the media on the left instead of the right (desktop only). */
  flip?: boolean;
  /** Pin the media while the text scrolls past. Good for long sections. */
  sticky?: boolean;
  /** Give the media column more room — useful for wide diagrams. */
  wide?: boolean;
  class?: string;
}

const { flip = false, sticky = false, wide = false, class: className } = Astro.props;
---

<div class:list={['media-split', { flip, sticky, wide }, className]}>
  <div class="col-text prose">
    <slot />
  </div>
  <div class="col-media">
    <slot name="media" />
  </div>
</div>

<style>
  .media-split {
    display: grid;
    gap: 1.75rem;
    align-items: start;
    margin-block: clamp(2.25rem, 5vw, 3.5rem);
  }

  .col-text > :global(:first-child) {
    margin-top: 0;
  }

  /* Headings inside a split are section headings, so they need no extra
     top margin — the split itself already provides the rhythm. */
  .col-text :global(h3:first-child),
  .col-text :global(h2:first-child) {
    margin-top: 0;
  }

  .col-text {
    max-width: 62ch;
  }

  @media (min-width: 900px) {
    .media-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
      gap: clamp(2rem, 4vw, 3.25rem);
      align-items: center;
    }

    .media-split.wide {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    }

    .media-split.flip .col-text {
      order: 2;
    }

    .media-split.flip .col-media {
      order: 1;
    }

    .media-split.sticky {
      align-items: start;
    }

    .media-split.sticky .col-media {
      position: sticky;
      top: calc(var(--header-h) + 1.75rem);
    }
  }
</style>
