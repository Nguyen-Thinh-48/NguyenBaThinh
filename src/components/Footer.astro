---
import { site } from '../site.config';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="col">
      <p class="eyebrow">Get in touch</p>
      <p class="pitch">
        Open to Edge AI, computer vision and embedded systems roles.
        The fastest way to reach me is email.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="2.6" y="4.8" width="18.8" height="14.4" rx="2.4" />
            <path d="m3.4 6.6 8.6 6.2 8.6-6.2" />
          </svg>
          {site.email}
        </a>
        <a class="btn btn-ghost" href={site.links.github} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 1.8a10.2 10.2 0 0 0-3.2 19.9c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7 0-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.2 10.2 0 0 0 12 1.8z" />
          </svg>
          GitHub
        </a>
        <a class="btn btn-ghost" href={url(site.cv)} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3.4v11.4M7.8 10.6 12 14.8l4.2-4.2M4.4 18.2v1.2a1.2 1.2 0 0 0 1.2 1.2h12.8a1.2 1.2 0 0 0 1.2-1.2v-1.2" />
          </svg>
          Download CV
        </a>
      </div>
    </div>

    <div class="meta">
      <span>{site.location}</span>
      <span aria-hidden="true">·</span>
      <span>© {year} {site.name}</span>
      <span aria-hidden="true">·</span>
      <span>Built with Astro, deployed by GitHub Actions</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
    padding-block: clamp(2.5rem, 5vw, 3.75rem) 2rem;
    margin-top: auto;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 46rem;
  }

  .pitch {
    font-size: 1.05rem;
    color: var(--text);
    max-width: 44ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.735rem;
    color: var(--text-faint);
  }
</style>
