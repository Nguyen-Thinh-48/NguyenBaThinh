---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import StatGrid from '../components/StatGrid.astro';
import StackList from '../components/StackList.astro';
import SourceBadge from '../components/SourceBadge.astro';
import Video from '../components/Video.astro';
import Figure from '../components/Figure.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { data } = project;
---

<Base title={data.title} description={data.summary}>
  <article class="case">
    <header class="case-header">
      <div class="container">
        <a class="back" href={url('/projects')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H6M11.5 5.5 5 12l6.5 6.5" />
          </svg>
          All work
        </a>

        <p class="meta mono">
          <span>{data.org}</span>
          <span aria-hidden="true">·</span>
          <span>{data.role}</span>
          <span aria-hidden="true">·</span>
          <span>{data.period}</span>
        </p>

        <h1>{data.title}</h1>
        <p class="lede">{data.tagline}</p>

        <ul class="chip-list">
          {data.tags.map((tag) => <li class="chip chip-accent">{tag}</li>)}
        </ul>

        <div class="source">
          <SourceBadge source={data.source} />
        </div>
      </div>
    </header>

    {
      (data.video || data.image) && (
        <div class="container hero-media">
          {data.video ? (
            <Video src={data.video} poster={data.poster} caption={data.mediaCaption} ratio={data.ratio} />
          ) : (
            <Figure
              src={data.image!}
              alt={data.mediaCaption ?? data.title}
              caption={data.mediaCaption}
              ratio={data.ratio}
              fit="contain"
            />
          )}
        </div>
      )
    }

    {
      data.highlights.length > 0 && (
        <div class="container results">
          <h2 class="eyebrow">Results</h2>
          <StatGrid items={data.highlights} dense />
        </div>
      )
    }

    <div class="container">
      <div class="case-body prose">
        <slot />
      </div>
    </div>

    {
      data.stack.length > 0 && (
        <div class="container stack-section">
          <StackList groups={data.stack} title="Technical stack" />
        </div>
      )
    }

    <nav class="container pager" aria-label="More projects">
      {
        prev ? (
          <a class="pager-link prev" href={url(`/projects/${prev.id}`)}>
            <span class="pager-dir mono">Previous</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="pager-link next" href={url(`/projects/${next.id}`)}>
            <span class="pager-dir mono">Next</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .case-header {
    padding-block: clamp(2rem, 4.5vw, 3.25rem) clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--border);
    background: var(--bg-alt);
  }

  .case-header .container {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    align-items: start;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .back svg {
    width: 1em;
    height: 1em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0;
  }

  .case-header h1 {
    max-width: 20ch;
  }

  .source {
    margin-top: 0.35rem;
  }

  .hero-media {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  .results {
    margin-top: clamp(2rem, 4.5vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stack-section {
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--border);
  }

  /* ---- Slotted MDX body -------------------------------------------------
     The body is full-container width so a <MediaSplit> can use both columns,
     while plain prose stays at a comfortable measure. */

  .case-body {
    max-width: none;
    margin-top: clamp(2rem, 4.5vw, 3rem);
  }

  .case-body > :global(p),
  .case-body > :global(ul),
  .case-body > :global(ol),
  .case-body > :global(h2),
  .case-body > :global(h3),
  .case-body > :global(h4),
  .case-body > :global(blockquote),
  .case-body > :global(pre) {
    max-width: 72ch;
  }

  .case-body > :global(h2) {
    font-size: clamp(1.35rem, 1.15rem + 0.9vw, 1.75rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }

  .case-body > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  /* ---- Pager ------------------------------------------------------------ */

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-block: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--border);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pager-link:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .pager-link.next {
    text-align: right;
    grid-column: 2;
  }

  .pager-dir {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link.next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
