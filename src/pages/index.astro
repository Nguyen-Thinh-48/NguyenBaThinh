---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatGrid from '../components/StatGrid.astro';
import CareerTree from '../components/CareerTree.astro';
import PaperCard from '../components/PaperCard.astro';
import Portrait from '../components/Portrait.astro';
import { site } from '../site.config';
import { url } from '../lib/url';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const featured = projects.filter((p) => p.data.featured);
const restCount = projects.length - featured.length;
---

<Base>
  <!-- Hero -->
  <section class="hero grid-bg">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{site.location}</p>

        <h1>
          I build AI that runs<br />
          <span class="accent">on the device</span>, not in the cloud.
        </h1>

        <p class="lede hero-lede">{site.description}</p>

        <div class="hero-actions">
          <a class="btn btn-primary" href={url('/projects')}>
            See the work
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13M12.5 5.5 19 12l-6.5 6.5" />
            </svg>
          </a>
          <a class="btn btn-ghost" href={url(site.cv)} target="_blank" rel="noopener">Download CV</a>
          <a class="btn btn-ghost" href={`mailto:${site.email}`}>Email me</a>
        </div>
      </div>

      <Portrait class="hero-portrait" size={210} />

      <div class="hero-stats">
        <StatGrid items={site.stats} />
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Featured work</p>
        <h2>Three systems, three different constraints</h2>
        <p class="lede">
          A drone that has to stay controllable over a flaky mobile network, a
          recognition box that has to hit 25 FPS on a 5&nbsp;W accelerator, and a
          transformer written by hand so the quantization stops being a black box.
        </p>
      </div>

      <div class="featured-grid">
        {featured.map((project) => <ProjectCard project={project} featured />)}
      </div>

      {
        restCount > 0 && (
          <a class="more" href={url('/projects')}>
            {restCount} more {restCount === 1 ? 'project' : 'projects'}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13M12.5 5.5 19 12l-6.5 6.5" />
            </svg>
          </a>
        )
      }
    </div>
  </section>

  <!-- Publication -->
  <section class="section paper-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Published research</p>
        <h2>The pruning result, peer reviewed</h2>
        <p class="lede">
          The structured pruning that made the face recognition model smaller and
          more accurate was written up and published by Springer.
        </p>
      </div>

      <PaperCard bare />
    </div>
  </section>

  <!-- Expertise -->
  <section class="section expertise-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What I work with</p>
        <h2>From the sensor to the API</h2>
        <p class="lede">
          Most of my projects span the whole path: a camera or a flight controller at
          one end, a trained model squeezed onto an accelerator in the middle, and a
          Go or Python service handing results to whoever needs them.
        </p>
      </div>

      <div class="expertise-grid">
        {
          site.expertise.map((group) => (
            <div class="expertise-card">
              <h3>{group.group}</h3>
              <ul class="chip-list">
                {group.items.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Experience</p>
        <h2>Where I have done it</h2>
        <p class="lede">
          Three roles that overlapped rather than followed one another — a
          part-time IT job, a research job and a product job, all three running
          at once through the second half of 2025, alongside the degree.
        </p>
      </div>

      <CareerTree />

      <p class="about-link">
        <a href={url('/about')}>Education, research and the full background →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */

  .hero {
    border-bottom: 1px solid var(--border);
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4.5rem);
    position: relative;
    overflow: hidden;
  }

  .hero::after {
    /* Fade the grid out toward the bottom so it does not fight the content. */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, var(--bg) 100%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.15rem;
    align-items: start;
    justify-items: start;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    align-items: start;
    min-width: 0;
  }

  /* The hero already carries a headline, a paragraph, three buttons and a stat
     row. On a phone the portrait is one element too many, and the About page
     shows it at full size anyway. */
  .hero-portrait {
    display: none;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }

    .hero-portrait {
      display: block;
      justify-self: end;
    }

    .hero-stats {
      grid-column: 1 / -1;
    }
  }

  .hero h1 {
    max-width: 18ch;
  }

  .accent {
    color: var(--accent);
  }

  .hero-lede {
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .hero-stats {
    width: 100%;
    margin-top: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  /* ---- Section scaffolding ---- */

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: start;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
    max-width: 62ch;
  }

  .section-head h2 {
    max-width: 20ch;
  }

  /* ---- Featured ---- */

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(1.25rem, 2.5vw, 1.85rem);
  }

  @media (max-width: 400px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .more svg {
    width: 1em;
    height: 1em;
    transition: transform 0.18s ease;
  }

  .more:hover svg {
    transform: translateX(3px);
  }

  /* ---- Publication ---- */

  .paper-section {
    padding-top: 0;
  }

  /* ---- Expertise ---- */

  .expertise-section {
    background: var(--bg-alt);
    border-block: 1px solid var(--border);
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(268px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .expertise-card {
    background: var(--surface);
    padding: 1.35rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .expertise-card h3 {
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .about-link {
    margin-top: 1.75rem;
    font-weight: 600;
  }

  .about-link a {
    text-decoration: none;
  }
</style>
