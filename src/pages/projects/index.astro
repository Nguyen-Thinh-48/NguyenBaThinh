---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// Tag filter buttons are derived from the content, so adding a tag to a
// project file is all it takes to add a filter.
const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---

<Base
  title="Work"
  description="Case studies: edge AI face recognition on Hailo-8L, a 4G-connected drone platform, transformers written from scratch, and a self-hosted RAG chatbot."
>
  <section class="section-tight header">
    <div class="container">
      <p class="eyebrow">Selected work</p>
      <h1>Systems I have built</h1>
      <p class="lede">
        Five projects across edge inference, real-time networking and applied LLMs.
        Each one lists what the constraint was, what I changed, and what the numbers
        did afterwards.
      </p>

      <div class="filters" role="group" aria-label="Filter projects by technology">
        <button class="filter is-on" type="button" data-tag="all" aria-pressed="true">
          All <span class="count mono">{projects.length}</span>
        </button>
        {
          allTags.map((tag) => (
            <button class="filter" type="button" data-tag={tag} aria-pressed="false">
              {tag}
              <span class="count mono">
                {projects.filter((p) => p.data.tags.includes(tag)).length}
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="grid" id="project-grid">
        {
          projects.map((project) => (
            <div class="grid-item" data-tags={project.data.tags.join('|')}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
      <p class="empty mono" id="empty-state" hidden>No projects match that filter.</p>
    </div>
  </section>
</Base>

<style>
  .header {
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
  }

  .header .container {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: start;
  }

  .header h1 {
    max-width: 16ch;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.75rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .filter:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .filter.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .count {
    font-size: 0.7rem;
    opacity: 0.65;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: clamp(1.25rem, 2.5vw, 1.85rem);
  }

  @media (max-width: 400px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .grid-item[hidden] {
    display: none;
  }

  .empty {
    margin-top: 2rem;
    color: var(--text-faint);
    font-size: 0.85rem;
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.grid-item');
  const emptyState = document.getElementById('empty-state');

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.dataset.tag ?? 'all';

      filters.forEach((other) => {
        const on = other === button;
        other.classList.toggle('is-on', on);
        other.setAttribute('aria-pressed', String(on));
      });

      let visible = 0;
      items.forEach((item) => {
        const tags = (item.dataset.tags ?? '').split('|');
        const show = tag === 'all' || tags.includes(tag);
        item.hidden = !show;
        if (show) visible++;
      });

      if (emptyState) emptyState.hidden = visible > 0;
    });
  });
</script>
